{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "groupName": "react packages",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    }
  ]
}
